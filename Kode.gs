function sendRedamanAlert(sNum, rx, tx, rowData, status, headers) {
  var botToken = "8050598199:AAHpPcFNUaLmox5Y6J2Ea0IvDkkPawLsZd8";
  var chatId = "6874834483";
  
  if(botToken === "MASUKKAN_TOKEN_BOT_DI_SINI") return; 
  
  var ticketId = "-";
  var summary = "-";
  var sto = "-";
  
  if (headers && headers.length > 0) {
      var incIdx = -1, stoIdx = -1, sumIdx = -1;
      for (var h = 0; h < headers.length; h++) {
          var headerName = headers[h].toString().toUpperCase();
          if (headerName.indexOf("INCIDENT") !== -1 || headerName === "TICKET") incIdx = h;
          if (headerName === "STO" || headerName.indexOf("WITEL") !== -1) stoIdx = h;
          if (headerName === "SUMMARY" || headerName.indexOf("DESCRIPTION") !== -1) sumIdx = h;
      }

      if (incIdx > -1 && rowData[incIdx]) ticketId = rowData[incIdx].toString().trim();
      if (stoIdx > -1 && rowData[stoIdx]) sto = rowData[stoIdx].toString().trim();
      if (sumIdx > -1 && rowData[sumIdx]) summary = rowData[sumIdx].toString().trim();
  }
  
  // Fallback for ticketId
  if (ticketId === "-" || ticketId === "") {
      for (var i = 0; i < rowData.length; i++) {
          var cellText = (rowData[i] || "").toString().trim();
          var incMatch = cellText.match(/(INC\d{7,}|1-SV\d{7,})/);
          if (incMatch) {
              ticketId = incMatch[0];
              break;
          }
      }
  }
  
  // Fallback for summary
  if (summary === "-" || summary === "") {
      for (var i = 0; i < rowData.length; i++) {
          var cellText = (rowData[i] || "").toString().trim();
          if (cellText.includes("TECHNICAL") || cellText.includes("PROACTIVE") || cellText.includes("INTERNET")) {
              if (cellText.length > 20) {
                  summary = cellText.substring(0, 150);
                  break;
              }
          }
      }
  }
  
  // Fallback for sto
  if (sto === "-" || sto === "") {
      for (var i = 0; i < rowData.length; i++) {
         var cellText = (rowData[i] || "").toString().trim();
         if (/^[A-Z]{3}$/.test(cellText) && cellText !== "INC" && cellText !== "YES" && cellText !== "REG") {
             sto = cellText;
             break;
         }
      }
  }
  
  var escTicket = escapeHTML(ticketId);
  var shortSummary = escapeHTML(summary);
  var escSNum = escapeHTML(sNum);
  var escRx = escapeHTML(rx);
  var escTx = escapeHTML(tx);
  var escSto = escapeHTML(sto);
  
  var isGangguan = status && (status.toUpperCase() === 'LOS' || status.toUpperCase().includes('DYING'));
  
  var textMsg = isGangguan ? "⚠️ <b>ALERT: GANGGUAN LINK (LOS/DYING GASP)!</b> ⚠️\n\n" : "⚠️ <b>ALERT: REDAMAN TINGGI!</b> ⚠️\n\n";
  textMsg += "🎫 <b>INCIDENT:</b> <code>" + escTicket + "</code>\n";
  textMsg += "🔌 <b>NO INET:</b> <code>" + escSNum + "</code>\n";
  textMsg += "🏢 <b>STO:</b> <code>" + escSto + "</code>\n";
  if (status && status !== "Not Found") {
      textMsg += "🚨 <b>STATUS:</b> <code>" + escapeHTML(status) + "</code>\n";
  }
  textMsg += "🔴 <b>RX POWER:</b> <code>" + escRx + "</code>\n";
  textMsg += "🟢 <b>TX POWER:</b> <code>" + escTx + "</code>\n";
  textMsg += "📝 <b>SUMMARY:</b> <code>" + shortSummary + "...</code>\n";
  textMsg += "\n@Teknisi_Piket Mohon segera ditindaklanjuti dan submit evidence!";
  textMsg += "\n🔗 Login Web: <a href='http://localhost:8000'>Portal GGN</a>";
  
  var url = "https://api.telegram.org/bot" + botToken + "/sendMessage";
  var payload = {
    "chat_id": chatId,
    "text": textMsg,
    "parse_mode": "HTML"
  };
  
  var options = {
    "method": "post",
    "contentType": "application/json",
    "payload": JSON.stringify(payload)
  };
  
  try {
    Utilities.sleep(1000); // Mencegah Telegram Rate Limit (1 detik per pesan)
    UrlFetchApp.fetch(url, options);
  } catch(e) {
    console.log("Telegram Error: " + e.message);
  }
}

