function syncInseraToDatabase() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetScrape = ss.getSheetByName("SCRAPING INSERA");
  var sheetDB = ss.getSheetByName("DATABASE");
  
  if (!sheetScrape || !sheetDB) {
    SpreadsheetApp.getUi().alert("Tab SCRAPING INSERA atau DATABASE tidak ditemukan!");
    return;
  }
  
  checkAndCreateHeaders(sheetScrape, sheetDB);
  
  var lastRowScrape = sheetScrape.getLastRow();
  var dbLastRow = sheetDB.getLastRow();
  
  if (lastRowScrape < 2) {
    SpreadsheetApp.getUi().alert("Tidak ada data di SCRAPING INSERA.");
    return;
  }
  
  // Ambil semua tiket di DATABASE untuk cek duplikasi
  var existingTickets = new Set();
  if (dbLastRow > 1) {
    var dbData = sheetDB.getRange(2, 1, dbLastRow - 1, sheetDB.getLastColumn()).getValues();
    for (var i = 0; i < dbData.length; i++) {
       var row = dbData[i];
       for (var c = 0; c < row.length; c++) {
           var cell = (row[c] || "").toString().trim();
           if (cell.match(/^(INC|1-SV)/)) {
               existingTickets.add(cell);
           }
       }
    }
  }
  
  var scrapeData = sheetScrape.getRange(2, 1, lastRowScrape - 1, sheetScrape.getLastColumn()).getValues();
  var newRows = [];
  
  for (var i = 0; i < scrapeData.length; i++) {
     var row = scrapeData[i];
     var ticketId = null;
     for (var c = 0; c < row.length; c++) {
         var cell = (row[c] || "").toString().trim();
         if (cell.match(/^(INC|1-SV)/)) {
             ticketId = cell;
             break;
         }
     }
     
     if (ticketId && !existingTickets.has(ticketId)) {
         newRows.push(row);
         existingTickets.add(ticketId);
     }
  }
  
  if (newRows.length > 0) {
      sheetDB.getRange(dbLastRow + 1, 1, newRows.length, newRows[0].length).setValues(newRows);
      SpreadsheetApp.getUi().alert("✅ Berhasil memindahkan " + newRows.length + " tiket baru ke DATABASE.");
  } else {
      SpreadsheetApp.getUi().alert("ℹ️ Semua tiket sudah ada di DATABASE (Tidak ada data baru).");
  }
}

function escapeHTML(str) {
  if (!str) return "-";
  return str.toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

